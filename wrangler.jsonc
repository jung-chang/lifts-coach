{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifts-coach",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "lifts-coach", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" },
  "observability": { "enabled": true }
}
