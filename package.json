{
  "name": "lifts-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "test": "vitest run tests",
    "check:public": "node scripts/check-public.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "worker:dev": "wrangler dev",
    "cloudflare:configure": "node scripts/configure-cloudflare.mjs",
    "cloudflare:configure:local": "node --env-file=.env.deploy.local scripts/configure-cloudflare.mjs",
    "deploy": "pnpm build && pnpm cloudflare:configure && wrangler deploy --config wrangler.deploy.json",
    "db:migrate:local": "wrangler d1 migrations apply lifts-coach --local",
    "db:migrate:remote": "node scripts/configure-cloudflare.mjs --database-only && wrangler d1 migrations apply lifts-coach --remote --config wrangler.deploy.json",
    "format": "prettier --write src shared worker tests scripts evidence README.md CONTRIBUTING.md IMPLEMENTATION_CONTRACT.md package.json tsconfig.json vite.config.ts components.json .github/workflows/ci.yml",
    "format:check": "prettier --check src shared worker tests scripts evidence README.md CONTRIBUTING.md IMPLEMENTATION_CONTRACT.md package.json tsconfig.json vite.config.ts components.json .github/workflows/ci.yml"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@fontsource-variable/geist": "5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "ai": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.2.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
